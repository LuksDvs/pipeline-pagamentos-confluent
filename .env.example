# Copie para .env e preencha:  cp .env.example .env
# O .env está no .gitignore. Nunca versione senhas ou chaves.

# --- Confluent Cloud -------------------------------------------------
CC_ENV_NAME=desafio-final
CC_CLUSTER_NAME=desafio-basic
CC_CLOUD=aws
CC_REGION=us-east-1
CC_FLINK_POOL_NAME=desafio-pool
CC_FLINK_MAX_CFU=5

# --- Postgres (Neon) ----------------------------------------------
# Crie o projeto no Neon na mesma região do cluster (AWS us-east-1)
# e ative a replicação lógica em Settings > Logical Replication.
PG_HOST=ep-xxxxxx.us-east-1.aws.neon.tech
PG_PORT=5432
PG_DB=neondb
# Usuário dono das tabelas (o que o Neon cria com o projeto)
PG_ADMIN_USER=neondb_owner
PG_ADMIN_PASSWORD=troque-aqui
# Usuário de leitura que o conector de CDC vai usar (criado pelo setup)
PG_CDC_USER=cdc_user
PG_CDC_PASSWORD=troque-por-uma-senha-forte

# --- Evolução opcional: score de risco com IA ----------------------
ENABLE_AI_SCORE=false
OPENAI_API_KEY=

# --- Evolução opcional: Tableflow (Iceberg) ------------------------
ENABLE_TABLEFLOW=false
