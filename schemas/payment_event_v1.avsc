{
  "type": "record",
  "name": "PaymentEvent",
  "namespace": "com.bootcamp.payments",
  "doc": "Contrato v1 do evento de pagamento publicado para os consumidores.",
  "fields": [
    {"name": "transaction_id", "type": "long"},
    {"name": "card_id", "type": "int"},
    {"name": "card_last4", "type": "string", "confluent:tags": ["PCI"]},
    {"name": "customer_document", "type": "string", "confluent:tags": ["PII"]},
    {"name": "merchant_id", "type": "int"},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 15, "scale": 2}},
    {"name": "currency", "type": "string"},
    {"name": "channel", "type": {"type": "enum", "name": "Channel", "symbols": ["pos", "ecommerce", "app"]}},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
